            Instance.new("TextLabel")

        Hint.Size =
            UDim2.new(0.4, -14, 0, 16)

        Hint.Position =
            UDim2.new(0.6, 0, 0, 5)

        Hint.BackgroundTransparency = 1
        Hint.Text = Description
