    local function Crow(delay, y, size, duration)

        task.delay(delay, function()

            if not Alive() then
                return
            end

            local Bird =
                KRYVEX.CreateIcon(
                    KRYVEX.DecoIcons.Crow or "bird",
                    {
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        Position = UDim2.new(-0.08, 0, y, 0),
                        Size = UDim2.fromOffset(size, size),
                        Color = Theme.Text,
                        Transparency = 0.15,
                        TextSize = math.floor(size * 0.8),
                        ZIndex = 3,
                    }
                )

            if not Bird then
                return
            end

            Bird.Parent = Root

            local Start = os.clock()
            local Conn

            Conn =
                RunService.Heartbeat:Connect(function()

                    if not Alive() then
                        Conn:Disconnect()
                        return
                    end

                    local Progress =
                        (os.clock() - Start) / duration

                    if Progress >= 1 then
                        Conn:Disconnect()
                        Bird:Destroy()
                        return
                    end

                    Bird.Position =
                        UDim2.new(
                            -0.08 + 1.2 * Progress, 0,
                            y + math.sin(Progress * math.pi * 4) * 0.02, 0
                        )

                    Bird.Rotation =
                        math.sin(Progress * math.pi * 8) * 10

                end)

        end)

    end

