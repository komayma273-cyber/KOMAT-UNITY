    -- LIGHTNING (เน€เธยเน€เธยเน€เธเธ’เน€เธยเน€เธยเน€เธเธ’: เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธเธ’เน€เธย + เน€เธเธเน€เธเธ’เน€เธเธเน€เธยเน€เธยเน€เธเธ’เน€เธยเน€เธเธ”เน€เธยเน€เธยเน€เธยเน€เธย)
    ----------------------------------------------------

    local Flash =
        Create(
            "Frame",
            {
                Size = UDim2.fromScale(1, 1),
                BackgroundColor3 = Color3.fromRGB(240, 230, 255),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                ZIndex = 6,
            }
        )

    Flash.Parent = Root

    local function Lightning()

        local Size = ScreenSize()

        local Bolt =
            Create(
                "Frame",
                {
                    Size = UDim2.fromScale(1, 1),
                    BackgroundTransparency = 1,
                    ZIndex = 5,
                }
            )

        Bolt.Parent = Root

        local Previous =
            Vector2.new(
                Size.X * (0.3 + math.random() * 0.4),
                0
            )

        local Segments = 8
        local Pieces = {}

        for _ = 1, Segments do

            local NextPoint =
                Vector2.new(
                    Previous.X + math.random(-45, 45),
                    Previous.Y + Size.Y * 0.62 / Segments
                )

            local Delta = NextPoint - Previous
            local Middle = (Previous + NextPoint) / 2

            local Piece =
                Create(
                    "Frame",
                    {
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        Position = UDim2.fromOffset(Middle.X, Middle.Y),
                        Size = UDim2.fromOffset(Delta.Magnitude + 2, 3),
                        Rotation = math.deg(math.atan2(Delta.Y, Delta.X)),
                        BackgroundColor3 = Color3.fromRGB(245, 235, 255),
                        BorderSizePixel = 0,
                    }
                )

            Piece.Parent = Bolt

            table.insert(Pieces, {
                Piece,
                AddStroke(Piece, Theme.FxMid, 0.45, 4),
            })

            Previous = NextPoint

        end

        Flash.BackgroundTransparency = 0.3

        task.wait(0.06)

        Tw(Flash, 0.15, { BackgroundTransparency = 1 })

        task.wait(0.12)

        Flash.BackgroundTransparency = 0.55

        task.wait(0.04)

        Tw(Flash, 0.3, { BackgroundTransparency = 1 })

        for _, Item in ipairs(Pieces) do
            Tw(Item[1], 0.35, { BackgroundTransparency = 1 })
            Tw(Item[2], 0.35, { Transparency = 1 })
        end

        task.wait(0.4)

        Bolt:Destroy()

    end

