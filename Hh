-- KRYVEX.CreateIcon("ghost", { Size, Position, AnchorPoint, Color, ZIndex })
-- เน€เธยเน€เธเธ—เน€เธยเน€เธยเน€เธยเน€เธเธ’: object, kind  ("image" = เน€เธยเน€เธเธเน€เธยเน€เธเธเน€เธยเน€เธยเน€เธเธเน€เธเธ”เน€เธย, "glyph" = เน€เธเธเน€เธเธ‘เน€เธยเน€เธเธ…เน€เธเธ‘เน€เธยเน€เธเธเน€เธโ€เน€เธยเน€เธเธเน€เธเธ“เน€เธเธเน€เธเธเน€เธย)
