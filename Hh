        function KRYVEX.IsImageIcon(icon)

            if type(icon) == "number" then
                return true
            end

            if type(icon) ~= "string" then
                return false
            end

            return icon:find("rbxassetid://", 1, true) ~= nil
                or icon:find("rbxthumb://", 1, true) ~= nil
                or icon:find("rbxasset://", 1, true) ~= nil
                or icon:match("^https?://") ~= nil
                or icon:match("^%d+$") ~= nil

        end

