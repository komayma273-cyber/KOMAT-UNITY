        Hint.Font = Enum.Font.Gotham
        Hint.TextXAlignment =
            Enum.TextXAlignment.Right
        Hint.TextTruncate =
            Enum.TextTruncate.AtEnd
        Hint.Parent = Frame

    end

    return Title

end

local function AddCorner(
    object,
    radius
)

    local corner =
        Instance.new("UICorner")

    corner.CornerRadius =
        UDim.new(
            0,
            radius or 8
        )

    corner.Parent =
        object

    return corner

end

