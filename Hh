local function ResolveIcon(
    icon
)

    if icon == nil
        or icon == ""
    then
        return nil
    end

    if type(icon) == "number" then

        return
            "image",
            {
                Image =
                    "rbxassetid://"
                    .. tostring(icon)
            }

    end

    if type(icon) == "table" then

        return
            "image",
            icon

    end

    icon =
        tostring(icon)

    if icon:find("rbxassetid://", 1, true)
        or icon:find("rbxthumb://", 1, true)
        or icon:find("rbxasset://", 1, true)
        or icon:match("^https?://")
    then

        return
            "image",
            {
                Image = icon
            }

    end

    if icon:match("^%d+$") then

        return
            "image",
            {
                Image =
                    "rbxassetid://"
                    .. icon
            }

    end

    local key =
        string.lower(icon)

    key =
        key:gsub("^lucide:", "")

    local registered =
        KRYVEX.Icons[key]

    if registered then

        if type(registered) == "table" then

            return
                "image",
                registered

        end

        return
            "image",
            {
                Image =
                    tostring(
                        registered
                    )
            }

    end

    local lucideIcon =
        GetLucideIcon(key)

    if lucideIcon then

        return
            "image",
            lucideIcon

    end

    return
        "glyph",
        KRYVEX.IconGlyphs[key]
        or "\u{25C8}"

end

