                    }
                )

            Frame.Parent =
                Page

            AddCorner(
                Frame,
                KRYVEX.Corners.Element
            )

            AddFieldLabel(
                Frame,
                config.Name or "Search",
                config.Description
            )

            local Input =
                Create(
                    "TextBox",
                    {

                        Size =
                            UDim2.new(
                                1,
                                -28,
                                1,
                                -32
                            ),

                        Position =
                            UDim2.fromOffset(
                                14,
                                26
                            ),

                        BackgroundColor3 =
                            KRYVEX.Theme.Background,

                        Text = "",

                        PlaceholderText =
                            config.Placeholder
                            or "\u{1F50D} \u{E04}\u{E49}\u{E19}\u{E2B}\u{E32}\u{E40}\u{E21}\u{E19}\u{E39}...",

                        PlaceholderColor3 =
                            KRYVEX.Theme.SubText,

                        TextColor3 =
                            KRYVEX.Theme.Text,

                        TextSize =
                            11,

                        Font =
                            Enum.Font.Gotham,

                        ClearTextOnFocus =
                            false,

                    }
                )

            Input.Parent =
                Frame

            AddCorner(
                Input,
                KRYVEX.Corners.Inner
            )

            local function Search(
                Query
            )

                Query =
                    string.lower(
                        Query or ""
                    )

                for _, Child in ipairs(
                    Page:GetChildren()
                ) do

                    if Child ~= Frame
                        and Child:IsA("GuiObject")
                        and not Child:IsA(
                            "UIListLayout"
                        )
                        and not Child:IsA(
                            "UIPadding"
                        )
                    then

                        if Query == "" then

                            Child.Visible =
                                true

                        else

                            local Name =
                                string.lower(
                                    Child.Name
                                    or ""
                                )

                            local Text =
                                ""

                            pcall(function()

                                Text =
                                    string.lower(
                                        Child.Text
                                        or ""
                                    )

                            end)

                            Child.Visible =
                                string.find(
                                    Name,
                                    Query,
                                    1,
                                    true
                                )
                                ~= nil
                                or
                                string.find(
                                    Text,
                                    Query,
                                    1,
                                    true
                                )
                                ~= nil

                        end

                    end

                end

            end

            Input:GetPropertyChangedSignal(
                "Text"
            ):Connect(
                function()

                    Search(
                        Input.Text
                    )

                    if config.Callback then

                        task.spawn(
                            config.Callback,
                            Input.Text
                        )

                    end

                end
            )

            return Input

        end

