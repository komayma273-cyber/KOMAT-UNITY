function KRYVEX.BuildScreenIntro(ScreenGui, TitleText, SubtitleText)

    local Theme = KRYVEX.Theme
    local FX = KRYVEX.HalloweenFX

    if not ScreenGui then
        return
    end

    if FX.ScreenIntroOnce and KRYVEX.ScreenIntroPlayed then
        return
    end

    KRYVEX.ScreenIntroPlayed = true

    local TweenService = game:GetService("TweenService")

    local function Tw(object, time, props, style, direction)
        TweenService:Create(
            object,
            TweenInfo.new(
                time,
                style or Enum.EasingStyle.Quad,
                direction or Enum.EasingDirection.Out
            ),
            props
        ):Play()
    end

    local function Round(object)
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0.5, 0)
        corner.Parent = object
    end

    local Root =
        Create(
            "Frame",
            {
                Name = "HalloweenScreenIntro",
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                ZIndex = 200,
            }
        )

    Root.Parent = ScreenGui

    local function Alive()
        return Root:IsDescendantOf(game)
    end

    local function ScreenSize()

        local size = Root.AbsoluteSize

        if size.X < 10 or size.Y < 10 then

            local camera = workspace.CurrentCamera

            return camera and camera.ViewportSize
                or Vector2.new(800, 450)

        end

        return size

    end

    -- เน€เธยเน€เธเธ‘เน€เธยเน€เธยเน€เธยเน€เธเธ’เน€เธย: เน€เธเธ…เน€เธยเน€เธโฌเน€เธเธเน€เธยเน€เธยเน€เธยเน€เธยเน€เธย เน€เธยเน€เธย 12 เน€เธเธเน€เธเธ”
