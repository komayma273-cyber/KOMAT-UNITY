    --=====================================================

    function Window:CreateTab(
        name,
        icon
    )

        local Tab = {}

        Tab.Name =
            name or "Tab"

        Tab.Icon =
            icon

        Tab.Elements =
            {}

        table.insert(
            Window.Tabs,
            Tab
        )

        --=================================================
        -- TAB BUTTON
        --=================================================

        local TabButton =
            Create(
                "TextButton",
                {

                    Size =
                        UDim2.new(
                            1,
                            0,
                            0,
                            36
                        ),

                    BackgroundColor3 =
                        KRYVEX.Theme.Sidebar,

                    BackgroundTransparency =
                        1,

                    Text =
                        Tab.Name,

                    TextColor3 =
                        KRYVEX.Theme.SubText,

                    TextSize =
                        12,

                    Font =
                        Enum.Font.GothamMedium,

                    TextXAlignment =
                        Enum.TextXAlignment.Left,

                    AutoButtonColor =
                        false,

                }
            )

        TabButton.Parent =
            TabHolder

        AddCorner(
            TabButton,
            8
        )

        local padding =
            Instance.new(
                "UIPadding"
            )

        padding.PaddingLeft =
            UDim.new(
                0,
                12
            )

        padding.Parent =
            TabButton

        --=================================================
        -- TAB ICON
        --=================================================

        local IconObject

        local iconKind, iconData =
            ResolveIcon(
                Tab.Icon
            )

        if iconKind then

            padding.PaddingLeft =
                UDim.new(
                    0,
                    38
                )

            if iconKind == "image" then

                IconObject =
                    Create(
                        "ImageLabel",
                        {

                            Size =
                                UDim2.fromOffset(
                                    18,
                                    18
                                ),

                            Position =
                                UDim2.new(
                                    0,
                                    -26,
                                    0.5,
                                    -9
                                ),

                            BackgroundTransparency =
                                1,

                            Image =
                                iconData.Image
                                or "",

                            ImageRectOffset =
                                iconData.ImageRectOffset
                                or Vector2.zero,

                            ImageRectSize =
                                iconData.ImageRectSize
                                or Vector2.zero,

                            ImageColor3 =
                                KRYVEX.Theme.SubText,

                            ScaleType =
                                Enum.ScaleType.Fit,

                        }
                    )

            else

                IconObject =
                    Create(
                        "TextLabel",
                        {

                            Size =
                                UDim2.fromOffset(
                                    18,
                                    18
                                ),

                            Position =
                                UDim2.new(
                                    0,
                                    -26,
                                    0.5,
                                    -9
                                ),

                            BackgroundTransparency =
                                1,

                            Text =
                                iconData,

                            TextColor3 =
                                KRYVEX.Theme.SubText,

                            TextSize =
                                16,

                            Font =
                                Enum.Font.GothamBold,

                        }
                    )

            end

            IconObject.Parent =
                TabButton

        end

        local function SetIconColor(
            tab,
            color
        )

            local obj =
                tab.IconObject

            if not obj then
                return
            end

            if obj:IsA("ImageLabel") then

                PlayTween(
                    obj,
                    0.15,
                    {
                        ImageColor3 =
                            color
                    }
                )

            else

                PlayTween(
                    obj,
                    0.15,
                    {
                        TextColor3 =
                            color
                    }
                )

            end

        end

        Tab.IconObject =
