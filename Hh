                )

            ValueLabel.Parent =
                Frame

            local Bar =
                Create(
                    "Frame",
                    {

                        Size =
                            UDim2.new(
                                1,
                                -28,
                                0,
                                6
                            ),

                        Position =
                            UDim2.fromOffset(
                                14,
                                43
                            ),

                        BackgroundColor3 =
                            KRYVEX.Theme.ToggleOff,

                    }
                )

            Bar.Parent =
                Frame

            AddCorner(
                Bar,
                6
            )

            local Fill =
                Create(
                    "Frame",
                    {

                        Size =
                            UDim2.new(

                                (
                                    value - min
                                )
                                /
                                (
                                    max - min
                                ),

                                0,

                                1,
                                0

                            ),

                        BackgroundColor3 =
                            KRYVEX.Theme.Primary,

                    }
                )

            Fill.Parent =
                Bar

            AddCorner(
                Fill,
                6
            )

            local Hitbox =
                Create(
                    "TextButton",
                    {

                        Size =
                            UDim2.new(
                                1,
                                0,
                                0,
                                24
                            ),

                        Position =
                            UDim2.new(
                                0,
                                0,
                                0.5,
                                -12
