        local Grad =
            Instance.new("UIGradient")

        Grad.Color =
            ColorSequence.new({
                ColorSequenceKeypoint.new(0, Dark),
                ColorSequenceKeypoint.new(0.35, Light),
                ColorSequenceKeypoint.new(0.7, Silver),
                ColorSequenceKeypoint.new(1, Dark),
            })

        Grad.Parent = Stroke

        task.spawn(function()

            while Alive() do

                Grad.Rotation =
                    reverse and 360 or 0

                local Spin =
                    TweenService:Create(
                        Grad,
                        TweenInfo.new(
                            speed,
                            Enum.EasingStyle.Linear
                        ),
                        {
                            Rotation =
                                reverse and 0 or 360
                        }
                    )

                Spin:Play()

                task.wait(speed)

            end

        end)

        return Stroke

    end

    local Glow =
        NebulaRing(16, 6, 0.8, 7, false)

    NebulaRing(9, 1.5, 0.25, 5, true)

    task.spawn(function()

        while Alive() do

            PlayTween(
                Glow,
                1.6,
                { Transparency = 0.55 },
                Enum.EasingStyle.Sine,
                Enum.EasingDirection.InOut
