    local function EyePair(x, y, delay)

        task.delay(delay, function()

            if not Alive() then
                return
            end

            local Pair =
                Create(
                    "Frame",
                    {
                        AnchorPoint = Vector2.new(0.5, 0.5),
                        Position = UDim2.new(x, 0, y, 0),
                        Size = UDim2.fromOffset(40, 12),
                        BackgroundTransparency = 1,
                        ZIndex = 4,
                    }
                )

            Pair.Parent = Root

            local Eyes = {}

            for Index, Offset in ipairs({ -12, 12 }) do

                local Eye =
                    Create(
                        "Frame",
                        {
                            AnchorPoint = Vector2.new(0.5, 0.5),
                            Position = UDim2.new(0.5, Offset, 0.5, 0),
                            Size = UDim2.fromOffset(12, 4),
                            Rotation = Index == 1 and 14 or -14,
                            BackgroundColor3 = Color3.fromRGB(255, 170, 40),
                            BackgroundTransparency = 1,
                            BorderSizePixel = 0,
                        }
                    )

                Eye.Parent = Pair

                AddCorner(Eye, 2)

                local Glow =
                    AddStroke(Eye, Color3.fromRGB(255, 120, 20), 1, 3)

                Tw(Eye, 0.3, { BackgroundTransparency = 0 })
                Tw(Glow, 0.3, { Transparency = 0.5 })

                table.insert(Eyes, { Eye, Glow })

            end

            task.wait(0.9)

            for _, Item in ipairs(Eyes) do
                Item[1].Size = UDim2.fromOffset(12, 1)
            end

            task.wait(0.12)

            for _, Item in ipairs(Eyes) do
                Item[1].Size = UDim2.fromOffset(12, 4)
            end

            task.wait(0.6)

            for _, Item in ipairs(Eyes) do
                Tw(Item[1], 0.4, { BackgroundTransparency = 1 })
                Tw(Item[2], 0.4, { Transparency = 1 })
            end

            task.wait(0.45)

            Pair:Destroy()

        end)

    end

