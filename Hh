local function GetPing()

    local success, result =
        pcall(function()

            return math.floor(
                Stats
                    .Network
                    .ServerStatsItem[
                        "Data Ping"
                    ]
                    :GetValue()
            )

        end)

    if success and result then

        return result

    end

    local success2, result2 =
        pcall(function()

            local text =
                Stats
                    .Network
                    .ServerStatsItem[
                        "Data Ping"
                    ]
                    :GetValueString()

            return tonumber(
                string.match(
                    text,
                    "%d+"
                )
            )

        end)

    if success2 and result2 then

        return result2

    end

    return 0

end

local function GetGameName()

    local gameName =
        game.Name

    task.spawn(function()

        local success, info =
            pcall(function()

                return MarketplaceService:GetProductInfo(
                    game.PlaceId
                )

            end)

        if success
            and info
            and info.Name
        then

            gameName =
                info.Name

        end

    end)

    return gameName

end

