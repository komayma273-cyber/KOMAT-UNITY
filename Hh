    local FloatGradient =
        Instance.new(
            "UIGradient"
        )

    FloatGradient.Color =
        ColorSequence.new({

            ColorSequenceKeypoint.new(
                0,
                KRYVEX.Theme.FloatEdge1
            ),

            ColorSequenceKeypoint.new(
                0.5,
                KRYVEX.Theme.FloatEdge2
            ),

            ColorSequenceKeypoint.new(
                1,
                KRYVEX.Theme.FloatEdge1
            ),

        })

    FloatGradient.Parent =
        FloatStroke

    task.spawn(function()

        while
            FloatButton.Parent
            and not Window.Destroyed
        do

            FloatGradient.Rotation =
                0

            local Spin =
                TweenService:Create(
                    FloatGradient,
                    TweenInfo.new(
                        4,
                        Enum.EasingStyle.Linear
                    ),
                    {
                        Rotation = 360
                    }
                )

            Spin:Play()

            Spin.Completed:Wait()

        end

    end)

    local FloatScale =
        Instance.new(
            "UIScale"
        )

    FloatScale.Scale =
        1

    FloatScale.Parent =
        FloatButton

    Window.FloatButton =
        FloatButton

    FixImage(
        FloatButton,
        "\u{E1B}\u{E38}\u{E48}\u{E21}\u{E40}\u{E1B}\u{E34}\u{E14}\u{E1B}\u{E34}\u{E14}"
    )

    --=====================================================
    -- SPACE EFFECT
    --=====================================================

    if KRYVEX.SpaceEffect ~= false then
        KRYVEX.BuildSpaceEffect(
            FloatButton,
            Window
        )
    end

    --=====================================================
    -- FLOAT DRAG
    --=====================================================

    local floatDragging =
        false

    local floatDragStart
    local floatStartPosition

    local floatMoved =
        false

    FloatButton.InputBegan:Connect(
        function(input)

            if input.UserInputType ==
                Enum.UserInputType.MouseButton1
                or
                input.UserInputType ==
                Enum.UserInputType.Touch
            then

                floatDragging =
                    true

                floatMoved =
                    false

                floatDragStart =
                    input.Position

                floatStartPosition =
                    FloatButton.Position

                input.Changed:Connect(
                    function()

                        if input.UserInputState ==
                            Enum.UserInputState.End
                        then

                            floatDragging =
                                false

                        end

                    end
                )

            end

        end
    )

    UserInputService.InputChanged:Connect(
        function(input)

            if not floatDragging then
                return
            end

            if input.UserInputType ==
                Enum.UserInputType.MouseMovement
                or
                input.UserInputType ==
                Enum.UserInputType.Touch
            then

                local delta =
                    input.Position
                    - floatDragStart

                if math.abs(delta.X) > 5
                    or
                    math.abs(delta.Y) > 5
                then

                    floatMoved =
                        true

                end

                FloatButton.Position =
                    UDim2.new(

                        floatStartPosition.X.Scale,

                        floatStartPosition.X.Offset
                        + delta.X,

                        floatStartPosition.Y.Scale,

                        floatStartPosition.Y.Offset
                        + delta.Y

                    )

            end

        end
    )

    --=====================================================
    -- FLOAT CLICK
    --=====================================================

    FloatButton.Activated:Connect(
        function()

            if floatMoved then
                return
            end

            if Window.Destroyed then
                return
            end

            local down =
                PlayTween(
                    FloatScale,
                    0.08,
                    {
                        Scale = 0.86
                    }
                )

            down.Completed:Wait()

            PlayTween(
                FloatScale,
                0.25,
                {
                    Scale = 1
                },
                Enum.EasingStyle.Back
            )

            Window:ToggleVisibility()

        end
    )

    --=====================================================
    -- FLOAT HOVER
    --=====================================================

    FloatButton.MouseEnter:Connect(
        function()

            PlayTween(
                FloatScale,
                0.18,
                {
                    Scale = 1.08
                }
            )

            PlayTween(
                FloatStroke,
                0.18,
                {
                    Thickness = 2.5
                }
            )

        end
    )

    FloatButton.MouseLeave:Connect(
        function()

            PlayTween(
                FloatScale,
                0.18,
                {
                    Scale = 1
                }
            )

            PlayTween(
                FloatStroke,
                0.18,
                {
                    Thickness = 2
                }
            )

        end
    )

    --=====================================================
    -- OPENING ANIMATION
    --=====================================================

    HideScale.Scale =
        0.85

    Main.BackgroundTransparency =
        1

    BgImage.ImageTransparency =
        1

    PlayTween(
        BgImage,
        0.6,
        {
            ImageTransparency =
                KRYVEX.Background.Transparency
        }
    )

    PlayTween(
        HideScale,
        0.45,
        {
            Scale = 1
        },

        Enum.EasingStyle.Back,
        Enum.EasingDirection.Out
    )

    PlayTween(
        Main,
        0.45,
        {

            Size =
                UDim2.fromOffset(
                    Window.Size.X,
                    Window.Size.Y
                ),

            Position =
                UDim2.new(

                    0.5,
                    -Window.Size.X / 2,

                    0.5,
                    -Window.Size.Y / 2

                ),

            BackgroundTransparency =
                KRYVEX.Glass.Main

        },

        Enum.EasingStyle.Back,
        Enum.EasingDirection.Out
    )

    --=====================================================
    -- WELCOME
    --=====================================================

    task.delay(
        0.5,
        function()

            if not Window.Destroyed then

                Window:Notify({

                    Title =
                        "Kryvex Hub v"
                        .. KRYVEX.Version,

                    Content =
                        "Library Loaded Successfully \u{1F525}",

                    Duration =
                        3

                })

            end

        end
    )

    --=====================================================
    -- RETURN
    --=====================================================

    return Window

end

