    ----------------------------------------------------

    local function NebulaRing(
        pad,
        thickness,
        transparency,
        speed,
        reverse
    )

        local Ring =
            Create(
                "Frame",
                {
                    AnchorPoint =
                        Vector2.new(0.5, 0.5),

                    Position =
                        UDim2.fromScale(0.5, 0.5),

                    Size =
