local function PlayTween(
    object,
    time,
    properties,
    style,
    direction
)

    local tween =
        TweenService:Create(

            object,

            TweenInfo.new(

                time or 0.25,

                style
                    or Enum.EasingStyle.Quad,

                direction
                    or Enum.EasingDirection.Out

            ),

            properties

        )

    tween:Play()

    return tween

end

