    --=====================================================
    -- MINIMIZE
    --=====================================================

    function Window:Minimize(
        state
    )

        if Window.Destroyed
            or Window.IsHidden
        then
            return
        end

        if state == nil then

            state =
                not Window.IsMinimized

        end

        Window.IsMinimized =
            state

        if state then

            Window.LastSize =
                Vector2.new(
                    Main.AbsoluteSize.X,
                    Main.AbsoluteSize.Y
                )

            PlayTween(
                Main,
                0.3,
                {

                    Size =
                        UDim2.fromOffset(
                            Window.LastSize.X,
                            58
                        )

                },

                Enum.EasingStyle.Quart,
                Enum.EasingDirection.InOut
            )

            MinimizeButton.Text =
                "+"

        else

            PlayTween(
                Main,
                0.35,
                {

                    Size =
                        UDim2.fromOffset(
                            Window.LastSize.X,
                            Window.LastSize.Y
                        )

                },

                Enum.EasingStyle.Back,
                Enum.EasingDirection.Out
            )

            MinimizeButton.Text =
                "-"

        end

    end

    --=====================================================
    -- HIDE
    --=====================================================

    function Window:Hide()

        if Window.Destroyed
            or Window.IsHidden
        then
            return
        end

        Window.IsHidden =
            true

        Window.LastSize =
            Vector2.new(
                Main.AbsoluteSize.X,
                Main.AbsoluteSize.Y
            )

        Window.LastPosition =
            Main.Position

        Main.Active =
            false

        PlayTween(
            BgImage,
            0.32,
            {
                ImageTransparency = 1
            }
        )

        PlayTween(
            HideScale,
            0.32,
            {
                Scale = 0.82
            },

            Enum.EasingStyle.Back,
            Enum.EasingDirection.In
        )

        PlayTween(
            Main,
            0.32,
            {

                Position =
                    UDim2.new(

                        Window.LastPosition.X.Scale,

                        Window.LastPosition.X.Offset,

                        Window.LastPosition.Y.Scale,

                        Window.LastPosition.Y.Offset
                        + 20

                    ),

                BackgroundTransparency =
                    1

            },

            Enum.EasingStyle.Quart,
            Enum.EasingDirection.In
        )

        task.delay(
            0.33,
            function()

                if Window.IsHidden
                    and not Window.Destroyed
                then

                    Main.Visible =
                        false

                end

            end
        )

    end

    --=====================================================
    -- SHOW
    --=====================================================

    function Window:Show()

        if Window.Destroyed
            or not Window.IsHidden
        then
            return
        end

        Window.IsHidden =
            false

        Main.Visible =
            true

        local Position =
            Window.LastPosition
            or Main.Position

        Main.Position =
            UDim2.new(

                Position.X.Scale,

                Position.X.Offset,

                Position.Y.Scale,

                Position.Y.Offset
                + 20

            )

        HideScale.Scale =
            0.82

        Main.BackgroundTransparency =
            1

        BgImage.ImageTransparency =
            1

        PlayTween(
            BgImage,
            0.4,
            {
                ImageTransparency =
                    KRYVEX.Background.Transparency
            }
        )

        Main.Active =
            true

        PlayTween(
            HideScale,
            0.4,
            {
                Scale = 1
            },

            Enum.EasingStyle.Back,
            Enum.EasingDirection.Out
        )

        PlayTween(
            Main,
            0.4,
            {

                Position =
                    Position,

                BackgroundTransparency =
                    KRYVEX.Glass.Main

            },

            Enum.EasingStyle.Back,
            Enum.EasingDirection.Out
        )

    end

    --=====================================================
    -- TOGGLE VISIBILITY
    --=====================================================

    function Window:ToggleVisibility()

        if Window.Destroyed then
            return
        end

        if Window.IsHidden then

            Window:Show()

        else

            Window:Hide()

        end

    end

    --=====================================================
    -- SET SIZE
    --=====================================================

    function Window:SetSize(
        width,
        height
    )

        if Window.Destroyed then
            return
        end

        width =
            math.clamp(
                width,
                Window.MinSize.X,
                Window.MaxSize.X
            )

        height =
            math.clamp(
                height,
                Window.MinSize.Y,
                Window.MaxSize.Y
            )

        Window.Size =
            Vector2.new(
                width,
                height
            )

        Window.LastSize =
            Vector2.new(
                width,
                height
            )

        PlayTween(
            Main,
            0.25,
            {

                Size =
                    UDim2.fromOffset(
                        width,
                        height
                    )

            }
        )

    end

    --=====================================================
    -- DESTROY
    --=====================================================

    function Window:Destroy()

        if Window.Destroyed then
            return
        end

        Window.Destroyed =
            true

        if FloatScale then

            PlayTween(
                FloatScale,
                0.2,
                {
                    Scale = 0
                },

                Enum.EasingStyle.Back,
                Enum.EasingDirection.In
            )

        end

        PlayTween(
            BgImage,
            0.3,
            {
                ImageTransparency = 1
            }
        )

        local tween =
            PlayTween(
                Main,
                0.3,
                {

                    Size =
                        UDim2.fromOffset(

                            Main.AbsoluteSize.X
                            * 0.8,

                            Main.AbsoluteSize.Y
                            * 0.8

                        ),

                    BackgroundTransparency =
                        1,

                    Position =
                        UDim2.new(

                            Main.Position.X.Scale,

                            Main.Position.X.Offset,

                            Main.Position.Y.Scale,

                            Main.Position.Y.Offset
                            + 20

                        )

                },

                Enum.EasingStyle.Back,
                Enum.EasingDirection.In
            )

        tween.Completed:Connect(
            function()

                if ScreenGui then
                    ScreenGui:Destroy()
                end

                if FloatGui then
                    FloatGui:Destroy()
                end

            end
        )

    end

