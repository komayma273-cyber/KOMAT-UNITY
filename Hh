                        ZIndex = 6,
                    }
                )

            Ember.Parent = Root

            Round(Ember)

            Tw(Ember, 0.7, {
                BackgroundTransparency = 1,
                Position =
                    UDim2.new(
                        x, math.random(-20, 20),
                        y, -70
                    ),
            })

            task.delay(0.75, function()
                Ember:Destroy()
            end)

        end

    end

    local function WolfRun()

        local Wolf =
            KRYVEX.CreateIcon(
                KRYVEX.DecoIcons.Wolf or "dog",
                {
                    AnchorPoint = Vector2.new(0.5, 1),
                    Position = UDim2.new(-0.12, 0, 0.94, 0),
                    Size = UDim2.fromOffset(96, 96),
                    Color = Theme.FxWhite,
                    TextSize = 72,
                    ZIndex = 7,
                }
            )

        if Wolf then
            Wolf.Parent = Root
        end

        local RunIn, Leap, RunOut = 1.1, 1.0, 0.8
        local Total = RunIn + Leap + RunOut

        local Elapsed = 0
        local Trail = 0
        local Finished = false
        local Pulsed = false
        local Titled = false
        local Conn

        Conn =
            RunService.Heartbeat:Connect(function(dt)

                if not Alive() then
                    Conn:Disconnect()
                    Finished = true
                    return
                end

                Elapsed = Elapsed + dt
                Trail = Trail + dt

                local X, Y, Rot, OnGround

                if Elapsed < RunIn then

                    local U = Elapsed / RunIn

                    X = -0.12 + 0.46 * U
                    Y = 0.94 - math.abs(math.sin(U * math.pi * 5)) * 0.025
                    Rot = math.sin(U * math.pi * 5) * 6
                    OnGround = true

                elseif Elapsed < RunIn + Leap then

                    local U = (Elapsed - RunIn) / Leap

                    X = 0.34 + 0.34 * U
                    Y = 0.94 - 0.62 * math.sin(U * math.pi)
                    Rot = -32 + 64 * U
                    OnGround = false

                    -- เน€เธโ€“เน€เธเธ–เน€เธยเน€เธยเน€เธเธเน€เธโ€เน€เธเธเน€เธเธเน€เธยเน€เธเธเน€เธเธเน€เธโ€: เน€เธยเน€เธเธเน€เธเธเน€เธยเน€เธเธ‘เน€เธยเน€เธโ€”เน€เธเธเน€เธยเน€เธเธเน€เธเธ’เน€เธย + เน€เธโฌเน€เธเธเน€เธเธ•เน€เธเธเน€เธยเน€เธเธเน€เธเธเน€เธย
                    if U > 0.45 and not Pulsed then

                        Pulsed = true

                        Tw(Halo, 0.25, { Transparency = 0.4 })
                        Tw(Moon, 0.25, { BackgroundTransparency = 0 })

                        task.delay(0.3, function()
                            Tw(Halo, 0.5, { Transparency = 0.78 })
                            Tw(Moon, 0.5, { BackgroundTransparency = 0.12 })
                        end)

                        if Howl then
                            pcall(function()
                                Howl:Play()
                            end)
                        end

                    end

                else

                    local U =
                        math.min((Elapsed - RunIn - Leap) / RunOut, 1)

                    X = 0.68 + 0.46 * U
                    Y = 0.94 - math.abs(math.sin(U * math.pi * 4)) * 0.025
                    Rot = math.sin(U * math.pi * 4) * 6
                    OnGround = true

                end

                if Wolf then
                    Wolf.Position = UDim2.new(X, 0, Y, 0)
                    Wolf.Rotation = Rot
                end

                if Elapsed > RunIn + Leap and not Titled then
                    Titled = true
                    ShowTitle()
                end

                if Trail >= (OnGround and 0.14 or 0.05) then
                    Trail = 0
                    SpawnTrail(X, Y, OnGround)
                end

                if Elapsed >= Total then
                    Conn:Disconnect()
                    Finished = true
                end

            end)

        while not Finished and Alive() do
            task.wait()
        end

        if Wolf then
            Wolf:Destroy()
        end

    end

    ----------------------------------------------------
    -- TIMELINE
    ----------------------------------------------------

    task.spawn(function()

        pcall(function()

            Tw(Dim, 0.5, { BackgroundTransparency = 0.45 })

            for _, Frame in ipairs(Edges) do
